# 金十 MCP Bearer Token
# 复制此文件为 .env 并填入你的 Token：
#   cp .env.example .env
#
# 获取方式：前往 https://www.jin10.com/ 注册账号后，在个人中心申请 API Token

# [必填] 金十 MCP 服务 Bearer Token
JIN10_BEARER_TOKEN=

# [可选] 自定义 MCP 服务地址（默认: https://mcp.jin10.com/mcp）
# JIN10_MCP_SERVER_URL=

# [可选] 自定义 MCP 协议版本（默认: 2025-11-25）
# JIN10_MCP_PROTOCOL_VERSION=
